{
  "name": "zia-dlp-manager",
  "displayName": "Zscaler ZIA DLP Manager",
  "version": "1.0.0",
  "description": "Create, update, import, export, and delete Zscaler ZIA DLP policies via OneAPI.",
  "author": "Ramesh Mani",
  "license": "MIT",
  "homepage": "https://github.com/zerotrust-1923/zia-dlp-manager",
  "repository": "https://github.com/zerotrust-1923/zia-dlp-manager",
  "icon": "assets/icon.png",
  "categories": ["security", "policy-management"],
  "tags": ["zscaler", "zia", "dlp", "oneapi", "policy", "compliance"],

  "runtime": "python",
  "pythonVersion": ">=3.9",

  "install": {
    "command": "pip install -r requirements.txt"
  },

  "commands": [
    {
      "name": "export",
      "description": "Export DLP rules and supporting objects to CSV/JSON",
      "command": "python scripts/zia_dlp_export.py",
      "destructive": false
    },
    {
      "name": "import",
      "description": "Create DLP rules from JSON (single/multi/slab)",
      "command": "python scripts/zia_dlp_import.py",
      "destructive": true
    },
    {
      "name": "update",
      "description": "Update existing DLP rules from JSON",
      "command": "python scripts/zia_dlp_update.py",
      "destructive": true
    },
    {
      "name": "delete",
      "description": "Delete DLP rules with double confirmation",
      "command": "python scripts/zia_dlp_delete.py",
      "destructive": true
    }
  ],

  "env": {
    "ZSCALER_CLIENT_ID":      { "required": true,  "secret": true,  "description": "OneAPI OAuth2 client ID" },
    "ZSCALER_CLIENT_SECRET":  { "required": true,  "secret": true,  "description": "OneAPI OAuth2 client secret" },
    "ZSCALER_VANITY_DOMAIN":  { "required": true,  "secret": false, "description": "Tenant vanity domain (prefix of *.zslogin.net)" },
    "ZSCALER_API_BASE_URL":   { "required": false, "secret": false, "default": "https://api.zsapi.net" },
    "INPUT_JSON":             { "required": false, "secret": false, "default": "zia_dlp_policies.json" },
    "EXPORT_FORMAT":          { "required": false, "secret": false, "default": "both" }
  },

  "permissions": {
    "network": ["*.zsapi.net", "*.zslogin.net"],
    "filesystem": "read-write"
  }
}
